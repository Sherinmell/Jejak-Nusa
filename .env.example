# TiDB Cloud Serverless Connection Template
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=jejaknusa
TIDB_SSL=true

# Server-Only Admin Credentials (NEVER exposed to client bundle)
ADMIN_EMAIL=your_secret_admin_email
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_ACCESS_CODE=your_secret_admin_code
